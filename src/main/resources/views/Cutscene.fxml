<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<StackPane fx:id="rootPane" prefWidth="960" prefHeight="540" minWidth="640" minHeight="360"
           styleClass="cutscene-fundo" stylesheets="@../styles/Cutscene.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.exa863.anselmo_adna.controller.fx.CutsceneFxController">
    <children>
        <ImageView fx:id="imgCenario" mouseTransparent="true" preserveRatio="false" />
        <Region mouseTransparent="true" styleClass="cutscene-filtro" />
        <!-- Retratos em camada acima do cenario, mas atras da caixa de dialogo. -->
        <HBox fx:id="painelPersonagens" alignment="BOTTOM_CENTER" mouseTransparent="true"
              visible="false" managed="false" spacing="110" styleClass="cutscene-personagens">
            <children>
                <ImageView fx:id="imgProtagonista" preserveRatio="true" smooth="true" mouseTransparent="true" />
                <ImageView fx:id="imgInterlocutor" preserveRatio="true" smooth="true" mouseTransparent="true" />
            </children>
        </HBox>
        <BorderPane styleClass="cutscene-layout" pickOnBounds="false">
            <top>
                <VBox alignment="CENTER_LEFT" spacing="6" styleClass="cutscene-cabecalho">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="13">
                            <children>
                                <Button fx:id="btnMenuPausa" text="PAUSA" onAction="#abrirMenuPausa" styleClass="cutscene-menu" />
                                <Label fx:id="lblParte" text="PRÓLOGO" styleClass="cutscene-parte" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblProgresso" text="CENA 1 DE 6" styleClass="cutscene-contador" />
                            </children>
                        </HBox>
                        <Label fx:id="lblTitulo" text="ANOS ATRÁS" styleClass="cutscene-titulo" wrapText="true" />
                    </children>
                </VBox>
            </top>
            <center>
                <StackPane />
            </center>
            <bottom>
                <VBox spacing="8" styleClass="cutscene-base">
                    <children>
                        <VBox spacing="8" styleClass="cutscene-dialogo">
                            <children>
                                <Label fx:id="lblEmissor" text="NARRADOR" styleClass="cutscene-emissor" />
                                <Label fx:id="lblTexto" text="" styleClass="cutscene-texto" wrapText="true" minHeight="66" maxWidth="890" />
                                <VBox fx:id="caixaOpcoes" spacing="7" visible="false" managed="false" />
                            </children>
                        </VBox>
                        <HBox alignment="CENTER_LEFT" spacing="9">
                            <children>
                                <Label fx:id="lblAviso" text="ENTER OU CLIQUE PARA CONTINUAR" styleClass="cutscene-ajuda" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnPular" text="PULAR FALAS  »" onAction="#pular" styleClass="cutscene-pular" />
                                <Button fx:id="btnAvancar" text="PRÓXIMA CENA  →" onAction="#avancar" styleClass="cutscene-avancar" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </bottom>
        </BorderPane>
    </children>
</StackPane>
