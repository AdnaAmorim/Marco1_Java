<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane" styleClass="modal-overlay" stylesheets="@../styles/Inventario.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.exa863.anselmo_adna.controller.fx.InventarioController">
   <children>
      <VBox maxHeight="-Infinity" maxWidth="-Infinity" scaleX="${rootPane.height / 540.0}" scaleY="${rootPane.height / 540.0}" styleClass="modal-card, inv-card">
         <children>
            <HBox styleClass="inv-header">
               <children>
                  <Label styleClass="modal-titulo" text="MOCHILA DO ATLETA" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="lblStatus" styleClass="inv-status-pill" text="SAÚDE 100/100 • ENERGIA 100/100" />
               </children>
            </HBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="inv-scroll">
               <content>
                  <StackPane>
                     <children>
                        <FlowPane fx:id="gridItens" alignment="TOP_LEFT" styleClass="inv-grid" />
                        <Label fx:id="lblVazio" managed="false" styleClass="inv-vazio" text="SUA MOCHILA ESTÁ VAZIA. VISITE A LOJA DE TUDO NA CIDADE A!" visible="false" wrapText="true" />
                     </children>
                  </StackPane>
               </content>
            </ScrollPane>

            <HBox fx:id="boxDetalhe" styleClass="inv-detalhe-box">
               <children>
                  <ImageView fx:id="imgSelecionado" fitHeight="56" fitWidth="56" preserveRatio="true" smooth="true" />
                  <VBox spacing="3" HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="lblNomeItem" styleClass="inv-detalhe-titulo" text="SELECIONE UM ITEM" />
                        <Label fx:id="lblDescItem" styleClass="inv-detalhe-desc" text="CLIQUE EM UM ITEM DA MOCHILA PARA VER DETALHES." wrapText="true" />
                        <Label fx:id="lblEfeitoItem" styleClass="inv-detalhe-efeito" text="" />
                     </children>
                  </VBox>
                  <Button fx:id="btnUsar" disable="true" focusTraversable="false" onAction="#usarSelecionado" styleClass="botao-jogo" text="USAR ITEM" />
               </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12">
               <children>
                  <Label fx:id="lblMensagem" styleClass="inv-mensagem" text="" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnFechar" focusTraversable="false" onAction="#fechar" styleClass="botao-jogo" text="FECHAR" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</StackPane>
