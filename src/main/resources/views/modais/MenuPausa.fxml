<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.*?>
<StackPane fx:id="rootPane" alignment="CENTER" styleClass="pausa-overlay"
           stylesheets="@../../styles/modais/MenuPausa.css" focusTraversable="true"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.exa863.anselmo_adna.controller.fx.modais.MenuPausaController">
    <children>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    prefWidth="510" prefHeight="455" minHeight="0" maxWidth="540"
                    maxHeight="455" styleClass="pausa-scroll">
            <content>
        <VBox alignment="CENTER" spacing="17" maxWidth="500" prefWidth="470"
              styleClass="pausa-card">
            <children>
                <Label text="O LEGADO DO RINGUE" styleClass="pausa-marca" />
                <Label text="JOGO PAUSADO" styleClass="pausa-titulo" />
                <Label text="SUA HISTÓRIA CONTINUA QUANDO VOCÊ VOLTAR" wrapText="true"
                       styleClass="pausa-subtitulo" />
                <VBox spacing="10" alignment="CENTER" styleClass="pausa-opcoes">
                    <children>
                        <Button fx:id="btnContinuar" text="CONTINUAR" maxWidth="1.7976931348623157E308"
                                onAction="#continuar" styleClass="pausa-botao, pausa-primario" />
                        <Button fx:id="btnConfiguracoes" text="CONFIGURAÇÕES" maxWidth="1.7976931348623157E308"
                                onAction="#abrirConfiguracoes" styleClass="pausa-botao" />
                        <Button fx:id="btnVoltarMenu" text="VOLTAR AO MENU" maxWidth="1.7976931348623157E308"
                                onAction="#voltarAoMenu" styleClass="pausa-botao, pausa-perigo" />
                    </children>
                </VBox>
                <Label text="ESC  •  RETOMAR O JOGO" styleClass="pausa-rodape" />
            </children>
        </VBox>
            </content>
        </ScrollPane>
    </children>
</StackPane>
