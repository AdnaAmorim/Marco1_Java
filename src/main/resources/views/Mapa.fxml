<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane" minHeight="0.0" minWidth="0.0" prefHeight="540.0" prefWidth="960.0" styleClass="mapa-root" stylesheets="@../styles/Mapa.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.exa863.anselmo_adna.controller.fx.MapaController">
   <children>
      <BorderPane>
         <top>
            <HBox alignment="CENTER_LEFT" maxHeight="-Infinity" styleClass="mapa-hud">
               <children>
                  <Label fx:id="lblAtleta" styleClass="hud-nome" text="ATLETA" />
                  <Label fx:id="lblSaude" styleClass="hud-stat, hud-saude" text="100/100" />
                  <Label fx:id="lblEnergia" styleClass="hud-stat, hud-energia" text="100/100" />
                  <Label fx:id="lblDinheiro" styleClass="hud-stat, hud-dinheiro" text="R$ 0" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="lblDataHora" styleClass="hud-data" text="DIA 1 • 06:00" />
                  <Button fx:id="btnMochila" focusTraversable="false" mnemonicParsing="false" onAction="#abrirMochila" styleClass="hud-botao, hud-botao-texto" text="MOCHILA" />
                  <Button fx:id="btnPausa" focusTraversable="false" mnemonicParsing="false" onAction="#abrirPausa" styleClass="hud-botao" text="" />
               </children>
            </HBox>
         </top>

         <center>
            <StackPane fx:id="areaMapa" minHeight="0.0" minWidth="0.0" styleClass="mapa-area">
               <children>
                  <ImageView fx:id="imgMapaBlurAnterior" managed="false" mouseTransparent="true" preserveRatio="false" smooth="true" visible="false" />
                  <ImageView fx:id="imgMapaBlur" managed="false" mouseTransparent="true" preserveRatio="false" smooth="true" visible="false" />
                  <Region fx:id="blurEscuro" mouseTransparent="true" styleClass="mapa-blur-escuro" visible="false" />
                  <Pane fx:id="mapaCanvas" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="540.0" prefWidth="960.0" styleClass="mapa-canvas">
                     <children>
                        <ImageView fx:id="imgMapaAnterior" fitHeight="540.0" fitWidth="960.0" mouseTransparent="true" preserveRatio="false" smooth="true" />
                        <ImageView fx:id="imgMapa" fitHeight="540.0" fitWidth="960.0" pickOnBounds="true" preserveRatio="false" smooth="true" />
                        <Pane fx:id="pinsLayer" prefHeight="540.0" prefWidth="960.0" />
                     </children>
                  </Pane>
               </children>
            </StackPane>
         </center>

         <bottom>
            <HBox alignment="CENTER" maxHeight="-Infinity" styleClass="mapa-rodape">
               <children>
                  <Label fx:id="lblInfoLocal" styleClass="mapa-info" text="CLIQUE EM UM LOCAL DA CIDADE PARA EXPLORAR." wrapText="true" />
               </children>
            </HBox>
         </bottom>
      </BorderPane>

      <VBox fx:id="painelViagem" alignment="CENTER" managed="false" maxHeight="-Infinity" maxWidth="-Infinity" scaleX="${rootPane.height / 540.0}" scaleY="${rootPane.height / 540.0}" styleClass="modal-card, viagem-card" visible="false" StackPane.alignment="CENTER">
         <children>
            <Label styleClass="modal-titulo, viagem-titulo" text="RODOVIÁRIA" />
            <Label styleClass="viagem-subtitulo" text="ESCOLHA SEU DESTINO DE VIAGEM" />
            <VBox fx:id="listaDestinos" alignment="CENTER" styleClass="viagem-lista" />
            <Button fx:id="btnFecharViagem" focusTraversable="false" mnemonicParsing="false" onAction="#fecharViagem" styleClass="botao-jogo, viagem-voltar" text="FECHAR" />
         </children>
      </VBox>
   </children>
</StackPane>
