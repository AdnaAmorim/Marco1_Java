<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<!-- Tela responsiva: dois painéis lado a lado em telas largas e empilhados em janelas pequenas. -->
<StackPane fx:id="rootPane" prefWidth="1280" prefHeight="720" minWidth="640" minHeight="360"
           styleClass="criacao-fundo" stylesheets="@../styles/CriacaoPersonagem.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.exa863.anselmo_adna.controller.fx.CriacaoPersonagemController">
    <children>
        <!-- Arte do próprio jogo: a academia de boxe. Só o fundo recebe o filtro. -->
        <ImageView fx:id="imgFundo" mouseTransparent="true" preserveRatio="false" smooth="true" />
        <Region styleClass="criacao-vinheta" mouseTransparent="true" />
        <ScrollPane fx:id="scrollConteudo" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    styleClass="criacao-scroll" pannable="true">
            <content>
                <!-- Faz o bloco ficar no centro real da janela; rola apenas quando necessário. -->
                <StackPane fx:id="centroConteudo" alignment="CENTER" minWidth="0">
                    <children>
                        <VBox alignment="CENTER" spacing="17" maxWidth="1320" styleClass="criacao-conteudo">
                            <children>
                                <Label text="ESCOLHA SEU PERSONAGEM" styleClass="criacao-titulo" />
                                <Label text="SUA HISTÓRIA  •  SEU NOME  •  SEU LEGADO" styleClass="criacao-subtitulo" />
                                <FlowPane alignment="CENTER" hgap="28" vgap="16" styleClass="criacao-corpo">
                                    <children>
                                        <VBox spacing="10" styleClass="criacao-form" prefWidth="510" maxWidth="510">
                                            <children>
                                                <Label text="01  IDENTIDADE" styleClass="criacao-secao" />
                                                <TextField fx:id="txtNome" promptText="Qual é o seu nome?" styleClass="criacao-entrada" />
                                                <Label text="02  PERSONAGEM" styleClass="criacao-secao" />
                                                <HBox spacing="12" alignment="CENTER">
                                                    <children>
                                                        <VBox fx:id="cardMasculino" spacing="5" alignment="CENTER" styleClass="personagem-card"
                                                              onMouseClicked="#selecionarMasculino">
                                                            <children>
                                                                <ImageView fx:id="imgMasculino" fitWidth="196" fitHeight="226" preserveRatio="true" smooth="true" />
                                                                <Label text="MASCULINO" styleClass="personagem-legenda" />
                                                                <Button text="SELECIONAR" onAction="#selecionarMasculino" styleClass="personagem-botao" />
                                                            </children>
                                                        </VBox>
                                                        <VBox fx:id="cardFeminino" spacing="5" alignment="CENTER" styleClass="personagem-card"
                                                              onMouseClicked="#selecionarFeminino">
                                                            <children>
                                                                <ImageView fx:id="imgFeminino" fitWidth="196" fitHeight="226" preserveRatio="true" smooth="true" />
                                                                <Label text="FEMININO" styleClass="personagem-legenda" />
                                                                <Button text="SELECIONAR" onAction="#selecionarFeminino" styleClass="personagem-botao" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>
                                                <Label text="03  COR DOS OLHOS" styleClass="criacao-secao" />
                                                <ComboBox fx:id="cmbOlhos" maxWidth="1.7976931348623157E308" styleClass="criacao-combo" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="9" alignment="CENTER" styleClass="criacao-ficha" prefWidth="468" maxWidth="468">
                                            <children>
                                                <Label text="SEU LUTADOR" styleClass="criacao-ficha-titulo" />
                                                <StackPane styleClass="criacao-palco" prefHeight="415" minHeight="415" maxHeight="415">
                                                    <children>
                                                        <Region styleClass="criacao-halo" maxWidth="365" maxHeight="395" />
                                                        <ImageView fx:id="imgPersonagemPrincipal" fitHeight="400" fitWidth="320"
                                                                   preserveRatio="true" smooth="true" />
                                                    </children>
                                                </StackPane>
                                                <Label fx:id="lblNomePreview" text="SEU BOXEADOR" styleClass="criacao-nome" wrapText="true" />
                                                <HBox spacing="9" alignment="CENTER">
                                                    <children>
                                                        <Label fx:id="lblSexoPreview" text="MASCULINO" styleClass="criacao-ficha-valor" />
                                                        <Label text="•" styleClass="criacao-ficha-campo" />
                                                        <Label fx:id="lblOlhosPreview" text="CASTANHO" styleClass="criacao-ficha-valor" />
                                                    </children>
                                                </HBox>
                                                <Label text="O RINGUE ESPERA POR VOCÊ." styleClass="criacao-ficha-dica" wrapText="true" />
                                            </children>
                                        </VBox>
                                    </children>
                                </FlowPane>
                                <Label fx:id="lblMensagem" text="" styleClass="criacao-erro" />
                                <HBox spacing="20" alignment="CENTER" styleClass="criacao-acoes">
                                    <children>
                                        <Button text="← VOLTAR" onAction="#voltar" styleClass="criacao-voltar" />
                                        <Button fx:id="btnConfirmar" text="COMEÇAR HISTÓRIA  →" onAction="#confirmar"
                                                styleClass="criacao-confirmar" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </StackPane>
            </content>
        </ScrollPane>
    </children>
</StackPane>
