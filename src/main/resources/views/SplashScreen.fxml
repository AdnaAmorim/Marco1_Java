<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<StackPane fx:id="rootPane" minHeight="0.0" minWidth="0.0" prefHeight="540.0" prefWidth="960.0" styleClass="splash-root" stylesheets="@../styles/SplashScreen.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.exa863.anselmo_adna.controller.fx.SplashScreenController">
   <children>
      <Region fx:id="fundoPreto" styleClass="splash-fundo" />

      <StackPane fx:id="logoWrapper" maxHeight="-Infinity" maxWidth="-Infinity" scaleX="${rootPane.height / 540.0}" scaleY="${rootPane.height / 540.0}">
         <children>
            <ImageView fx:id="imgLogo" fitHeight="225.0" fitWidth="400.0" opacity="0.0" pickOnBounds="true" preserveRatio="true" smooth="false" styleClass="splash-logo" />
         </children>
      </StackPane>

      <StackPane fx:id="madeByWrapper" maxHeight="-Infinity" maxWidth="-Infinity" mouseTransparent="true" scaleX="${rootPane.height / 540.0}" scaleY="${rootPane.height / 540.0}" styleClass="splash-madeby-wrapper">
         <children>
            <Label fx:id="lblMadeBy" opacity="0.0" styleClass="splash-madeby" text="MADE BY ANSELMO &amp; ADNA" />
         </children>
      </StackPane>
   </children>
</StackPane>
