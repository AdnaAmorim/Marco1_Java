<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="overlayPane" alignment="CENTER" styleClass="modal-overlay" stylesheets="@../styles/Saves.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.exa863.anselmo_adna.controller.fx.SavesController">
   <children>
      <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" scaleX="${overlayPane.height / 540.0}" scaleY="${overlayPane.height / 540.0}" styleClass="modal-card, saves-card">
         <children>
            <Label styleClass="modal-titulo" text="GERENCIAR SAVES" />

            <HBox alignment="CENTER" styleClass="saves-conteudo">
               <children>
                  <VBox fx:id="listaSlots" styleClass="lista-slots">
                     <children>
                        <Button fx:id="btnSlot1" focusTraversable="false" maxWidth="Infinity" mnemonicParsing="false" onAction="#selecionarSlot1" styleClass="slot-botao" text="SLOT 1" />
                        <Button fx:id="btnSlot2" focusTraversable="false" maxWidth="Infinity" mnemonicParsing="false" onAction="#selecionarSlot2" styleClass="slot-botao" text="SLOT 2" />
                        <Button fx:id="btnSlot3" focusTraversable="false" maxWidth="Infinity" mnemonicParsing="false" onAction="#selecionarSlot3" styleClass="slot-botao" text="SLOT 3" />
                        <Button fx:id="btnSlot4" focusTraversable="false" maxWidth="Infinity" mnemonicParsing="false" onAction="#selecionarSlot4" styleClass="slot-botao" text="SLOT 4" />
                        <Button fx:id="btnAutosave" focusTraversable="false" maxWidth="Infinity" mnemonicParsing="false" onAction="#selecionarAutosave" styleClass="slot-botao" text="AUTOMÁTICO" />
                     </children>
                  </VBox>

                  <VBox styleClass="detalhes-box" HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="lblSlotTitulo" styleClass="detalhe-titulo" text="SLOT 1" wrapText="true" />
                        <Label fx:id="lblJogador" styleClass="detalhe-texto" text="" wrapText="true" />
                        <Label fx:id="lblCapitulo" styleClass="detalhe-destaque" text="" wrapText="true" />
                        <Label fx:id="lblLocalData" styleClass="detalhe-texto" text="" wrapText="true" />
                        <Label fx:id="lblDataSalvamento" styleClass="detalhe-secundario" text="" wrapText="true" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <VBox alignment="CENTER" styleClass="mensagem-box">
               <children>
                  <Label fx:id="lblMensagem" styleClass="mensagem-texto" text="SELECIONE UM SLOT PARA CARREGAR, SALVAR OU EXCLUIR." wrapText="true" />
               </children>
            </VBox>

            <HBox alignment="CENTER" styleClass="acoes-bar">
               <children>
                  <Button fx:id="btnCarregar" focusTraversable="false" mnemonicParsing="false" onAction="#carregarSlot" styleClass="botao-jogo, botao-acao" text="CARREGAR" />
                  <Button fx:id="btnSalvar" focusTraversable="false" mnemonicParsing="false" onAction="#salvarSlot" styleClass="botao-jogo, botao-acao" text="SALVAR" />
                  <Button fx:id="btnExcluir" focusTraversable="false" mnemonicParsing="false" onAction="#excluirSlot" styleClass="botao-perigo, botao-acao" text="EXCLUIR" />
                  <Button fx:id="btnVoltar" focusTraversable="false" mnemonicParsing="false" onAction="#voltar" styleClass="botao-jogo, botao-acao" text="VOLTAR" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</StackPane>
