<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane" styleClass="modal-overlay" stylesheets="@../styles/Conquistas.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.exa863.anselmo_adna.controller.fx.ConquistasController">
   <children>
      <VBox maxHeight="-Infinity" maxWidth="-Infinity" scaleX="${rootPane.height / 540.0}" scaleY="${rootPane.height / 540.0}" styleClass="modal-card, conq-card">
         <children>
            <HBox styleClass="conq-header">
               <children>
                  <Label styleClass="modal-titulo" text="CONQUISTAS" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="lblResumo" styleClass="conq-contador" text="0 / 10  •  FINAIS: 0" />
               </children>
            </HBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="conq-scroll">
               <content>
                  <VBox fx:id="listaConquistas" styleClass="conq-lista" />
               </content>
            </ScrollPane>

            <HBox alignment="CENTER_RIGHT">
               <children>
                  <Button fx:id="btnFechar" focusTraversable="false" onAction="#fechar" styleClass="botao-jogo" text="VOLTAR" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</StackPane>
